#!/bin/sh
# Every commit runs staged-file checks, then the full CI gates (Turbo-cached).

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

bun scripts/commit-identity.mjs
bun scripts/pre-commit.mjs
# The full gates run tests; none of them may inherit the hook's pointer to this repository.
env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_PREFIX \
  bun scripts/pre-commit-full.mjs

{
  "name": "@localixai/os-open",
  "version": "0.1.0",
  "private": true,
  "description": "The one OS handoff for Bun/Node surfaces: hand a URL, a file, an app or a reveal to the operating system, and report what it answered.",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "bun test src",
    "type-check": "tsc --noEmit",
    "clean": "shx rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}

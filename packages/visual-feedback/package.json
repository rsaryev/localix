{
  "name": "@localixai/visual-feedback",
  "version": "0.1.0",
  "description": "Framework-agnostic in-page visual-feedback probe + protocol — element pick/comment on a live preview, mapped back to source for the agent.",
  "keywords": [
    "developer-tools",
    "localix",
    "source-map",
    "visual-feedback"
  ],
  "homepage": "https://localix.ai",
  "bugs": {
    "url": "https://github.com/rsaryev/localix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsaryev/localix.git",
    "directory": "packages/visual-feedback"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/probe/entry.js",
    "./src/probe/entry.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./protocol": {
      "import": "./dist/protocol/index.js",
      "types": "./dist/protocol/index.d.ts"
    },
    "./host": {
      "import": "./dist/host/index.js",
      "types": "./dist/host/index.d.ts"
    },
    "./keys": {
      "import": "./dist/keys/index.js",
      "types": "./dist/keys/index.d.ts"
    },
    "./embedded": {
      "import": "./dist/embedded/index.js",
      "types": "./dist/embedded/index.d.ts"
    },
    "./console-buffer": {
      "import": "./dist/actuate/console-capture.js",
      "types": "./dist/actuate/console-capture.d.ts"
    },
    "./probe-entry": {
      "types": "./dist/probe/entry.d.ts",
      "default": "./dist/probe/entry.js"
    },
    "./secret-shapes": {
      "import": "./dist/core/secret-shapes.js",
      "types": "./dist/core/secret-shapes.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "prepack": "bun run build",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "type-check": "tsc --noEmit",
    "test": "bun test src",
    "clean": "shx rm -rf dist .turbo"
  },
  "dependencies": {
    "modern-screenshot": "^4.7.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.3.14",
    "happy-dom": "21.0.4",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}

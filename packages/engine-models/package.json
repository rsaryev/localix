{
  "name": "@localixai/engine-models",
  "version": "0.1.0",
  "private": true,
  "description": "Localix model access: the models.dev catalog, @ai-sdk providers, OAuth, and the ModelSession a run streams through.",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@localixai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "type-check": "node ../../scripts/tsc.mjs --noEmit",
    "test": "bun test src",
    "clean": "shx rm -rf dist .turbo"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.121",
    "@ai-sdk/anthropic": "4.0.85",
    "@ai-sdk/azure": "4.0.107",
    "@ai-sdk/gateway": "4.0.121",
    "@ai-sdk/google": "4.0.102",
    "@ai-sdk/google-vertex": "5.0.119",
    "@ai-sdk/openai": "4.0.99",
    "@ai-sdk/openai-compatible": "3.0.75",
    "@ai-sdk/provider": "4.0.31",
    "@localixai/agent": "workspace:*",
    "@opencode-ai/models": "0.0.112",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}

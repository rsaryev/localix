{
  "name": "@localixai/agent-runtime-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Localix Pi runtime adapter — model execution, OAuth, and event translation.",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.tmp/tsconfig.tsbuildinfo",
    "test": "bun test src",
    "clean": "shx rm -rf dist .turbo"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "workspace:*",
    "@earendil-works/pi-ai": "workspace:*",
    "@localixai/agent": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.1",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}

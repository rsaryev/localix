{
  "name": "@localixai/uri",
  "version": "0.1.0",
  "private": true,
  "description": "The localix:// address grammar: UI destinations, resources, settings anchors and capability addresses.",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "bun test src",
    "type-check": "tsc --noEmit",
    "clean": "shx rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}

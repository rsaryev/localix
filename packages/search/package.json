{
  "name": "@localixai/search",
  "version": "0.1.0",
  "private": true,
  "description": "MiniSearch-based relevance scoring and ranking shared by Localix search surfaces.",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@localixai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./positions": {
      "@localixai/source": "./src/positions.ts",
      "types": "./dist/positions.d.ts",
      "import": "./dist/positions.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "bun test src",
    "type-check": "node ../../scripts/tsc.mjs --noEmit",
    "clean": "shx rm -rf dist .turbo"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}

{
  "name": "@localixai/kit",
  "version": "0.1.0",
  "private": true,
  "description": "The Localix UI kit: the primitives, recipes and tokens the app and every plugin build their surfaces from.",
  "keywords": [
    "components",
    "design-system",
    "localix",
    "react"
  ],
  "homepage": "https://localix.ai",
  "bugs": {
    "url": "https://github.com/rsaryev/localix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsaryev/localix.git",
    "directory": "packages/kit"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./styles/index.css",
    "./catalog": "./src/catalog/index.ts",
    "./testing/*": "./src/testing/*.ts",
    "./*": "./src/entries/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit",
    "test": "bun test src",
    "clean": "shx rm -rf .turbo"
  },
  "dependencies": {
    "@localixai/plugin-sdk": "workspace:*",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.24.0",
    "modern-screenshot": "^4.7.0",
    "pdfjs-dist": "6.2.108",
    "radix-ui": "^1.6.2",
    "vaul": "^1.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.13.0",
    "oxc-parser": "^0.137.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}

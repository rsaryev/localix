{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["bun"],
    "skipLibCheck": true,

    /* Source-only package: the consuming bundler (the app's Vite, a plugin's artifact build)
       compiles it, so it is checked here and never emitted. */
    "moduleResolution": "bundler",
    "customConditions": ["@localixai/source"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* A re-check reads what it learned last time instead of re-checking every primitive. */
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}

{
  "name": "@localixai/dataview",
  "version": "0.1.0",
  "description": "Provider-agnostic Localix data-view core — tables, charts, querying, summaries, and export formats.",
  "keywords": [
    "agent",
    "chart",
    "csv",
    "datagrid",
    "table"
  ],
  "homepage": "https://localix.ai",
  "bugs": {
    "url": "https://github.com/rsaryev/localix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsaryev/localix.git",
    "directory": "packages/dataview"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "prepack": "bun run build",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "bun test src",
    "type-check": "tsc --noEmit",
    "clean": "shx rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}

{
  "name": "@localixai/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Localix agent engine: the loop, model access and the script sandbox composed behind the AgentEngine port.",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "type-check": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.tmp/tsconfig.tsbuildinfo",
    "test": "bun test src",
    "clean": "shx rm -rf dist .turbo"
  },
  "dependencies": {
    "@localixai/agent": "workspace:*",
    "@localixai/engine-loop": "workspace:*",
    "@localixai/engine-models": "workspace:*",
    "@localixai/engine-scripts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}

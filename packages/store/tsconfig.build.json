{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "customConditions": [],
    "incremental": false,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}

{
  "name": "@localixai/engine-scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Localix script sandbox: JavaScript in QuickJS VMs with a memory limit and an interrupt — model-written scripts whose only capability is calling their tools, and long-lived VMs that exchange JSON with their host (mods).",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@localixai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "@localixai/source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "type-check": "bun ../../scripts/tsc.mjs --noEmit",
    "test": "bun test src",
    "clean": "shx rm -rf dist .turbo"
  },
  "dependencies": {
    "@localixai/agent": "workspace:*",
    "quickjs-wasi": "3.6.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}

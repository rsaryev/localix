{
  "name": "@localixai/engine-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Localix agent loop: turns, tool scheduling, hooks, steering — over a neutral model session.",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@localixai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "type-check": "node ../../scripts/tsc.mjs --noEmit",
    "test": "bun test src",
    "clean": "shx rm -rf dist .turbo"
  },
  "dependencies": {
    "@localixai/agent": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}

{
  "name": "@localixai/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic Localix agent contracts, context and runtime ports.",
  "keywords": [
    "agents",
    "ai",
    "llm",
    "streaming",
    "tools"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./history": {
      "types": "./dist/history/index.d.ts",
      "import": "./dist/history/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./images/downscale": {
      "types": "./dist/images/downscale.d.ts",
      "import": "./dist/images/downscale.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js"
    },
    "./chat-cache": {
      "types": "./dist/chat-cache.d.ts",
      "import": "./dist/chat-cache.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./agents/chat": {
      "types": "./dist/agents/chat.d.ts",
      "import": "./dist/agents/chat.js"
    },
    "./agents/items": {
      "types": "./dist/agents/items.d.ts",
      "import": "./dist/agents/items.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "bun test src",
    "type-check": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.tmp/tsconfig.tsbuildinfo",
    "clean": "shx rm -rf dist .turbo"
  },
  "dependencies": {
    "@jimp/core": "^1.6.1",
    "@jimp/js-jpeg": "^1.6.1",
    "@jimp/js-png": "^1.6.1",
    "@jimp/plugin-resize": "^1.6.1",
    "p-defer": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "jimp": "^1.6.1",
    "typescript": "^7.0.2"
  }
}

{
  "name": "@localixai/path-containment",
  "version": "0.1.0",
  "private": true,
  "description": "Security-focused path containment primitives with traversal-safe resolution and branded contained paths.",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@localixai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ancestry": {
      "@localixai/source": "./src/ancestry.ts",
      "types": "./dist/ancestry.d.ts",
      "import": "./dist/ancestry.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "bun test src",
    "type-check": "node ../../scripts/tsc.mjs --noEmit",
    "clean": "shx rm -rf dist .turbo"
  },
  "devDependencies": {
    "@localixai/source-lint": "workspace:*",
    "@types/bun": "1.4.3",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}

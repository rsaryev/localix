{
  "name": "@localixai/liveness",
  "version": "0.1.0",
  "private": true,
  "description": "Refcounted liveness watching for endpoints — TCP/HTTP/unix probes, owner-reported signals, adaptive scheduling, change-only events.",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./probe": {
      "types": "./dist/probe/index.d.ts",
      "import": "./dist/probe/index.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "bun test src",
    "type-check": "tsc --noEmit",
    "clean": "shx rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}

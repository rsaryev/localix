{
  "name": "@localixai/landing",
  "version": "0.0.0",
  "private": true,
  "description": "Localix product and documentation site — localix.ai.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "bun run generate",
    "dev": "vite --port 5173",
    "prebuild": "bun run generate",
    "build": "tsc -b && vite build",
    "postbuild": "bun run scripts/build-static-docs.mjs",
    "test": "bun test scripts src",
    "pretype-check": "bun run generate",
    "type-check": "tsc -b",
    "docs:gen": "bun run scripts/build-docs.mjs",
    "shots:gen": "bun run scripts/build-shots.mjs",
    "generate": "bun run docs:gen && bun run shots:gen",
    "preview": "vite preview",
    "clean": "shx rm -rf dist .turbo src/generated"
  },
  "dependencies": {
    "@localixai/kit": "workspace:*",
    "@localixai/markdown": "workspace:*",
    "@localixai/plugin-sdk": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.61.0",
    "motion": "13.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gray-matter": "^4.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && bunx turbo build --filter=@localixai/landing",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/getting-started--what-is-localix",
      "permanent": false
    }
  ],
  "rewrites": [{ "source": "/docs/:slug", "destination": "/docs/:slug.html" }],
  "headers": [
    {
      "source": "/.well-known/api-catalog",
      "headers": [{ "key": "Content-Type", "value": "application/linkset+json" }]
    }
  ]
}

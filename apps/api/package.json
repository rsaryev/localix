{
  "name": "@localixai/api",
  "version": "0.0.1",
  "private": true,
  "description": "Localix backend — agent runtime, tools, permissions, and realtime streaming (Hono + Bun).",
  "license": "MIT",
  "bin": {
    "localix": "./bin/localix"
  },
  "files": [
    "bin",
    "public",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent-mentions": "./src/features/chat/agent-mentions.ts",
    "./answer-markdown": "./src/features/agent-core/answer-markdown.ts",
    "./backoff": "./src/lib/backoff.ts",
    "./agent-policy": "./src/features/agents/policy.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./client": "./src/client.ts",
    "./external-agent-contracts": "./src/features/external-agents/shared/contracts.ts",
    "./external-agent-identity": "./src/features/external-agents/shared/identity.ts",
    "./external-agent-history-stream": "./src/features/external-agents/shared/history-stream.ts",
    "./external-agent-resource": "./src/features/external-agents/shared/resource-provider-id.ts",
    "./context-refs": "./src/contracts/context-refs.ts",
    "./item-format": "./src/features/chat/item-format.ts",
    "./loops-format": "./src/features/loops/format.ts",
    "./lsp-edits": "./src/features/lsp/lsp-edits.ts",
    "./notification-contracts": "./src/features/notifications/contracts.ts",
    "./mcp-command-line": "./src/features/mcp/command-line.ts",
    "./mcp-import": "./src/features/mcp/unwrap.ts",
    "./participant": "./src/db/participant.ts",
    "./permission-modes": "./src/contracts/permission-modes.ts",
    "./plugin-kit-layout": "./src/features/plugins/authoring/kit-layout.ts",
    "./plugin-kit": "./src/features/plugins/authoring/kit.ts",
    "./plugin-ui-build": "./src/features/plugins/authoring/ui-build.ts",
    "./plugin-view-target": "./src/contracts/plugin-view-target.ts",
    "./preview-actions": "./src/contracts/preview-actions.ts",
    "./queue-presentation": "./src/features/chat/queue-presentation.ts",
    "./recovery": "./src/features/notifications/recovery.ts",
    "./realtime-resources": "./src/features/realtime/resources.ts",
    "./secrets-limits": "./src/features/secrets/limits.ts",
    "./session-ref": "./src/contracts/session-ref.ts",
    "./session-title": "./src/features/chat/session-title.ts",
    "./session-route": "./src/contracts/session-route.ts",
    "./slash-catalog": "./src/features/chat/slash-catalog.ts",
    "./slash-match": "./src/features/chat/slash-match.ts",
    "./terminal-emulator": "./src/features/terminal/emulator.ts",
    "./tip-contracts": "./src/features/capabilities/tip-contracts.ts",
    "./tool-names": "./src/features/agent-core/tool-names.ts",
    "./turn-budget": "./src/contracts/turn-budget.ts",
    "./ui-token-rules": "./src/contracts/ui-token-rules.ts",
    "./wake-provenance": "./src/features/chat/wake-provenance.ts",
    "./wire-tools": "./src/features/tools/wire-tools.ts",
    "./ws-frame": "./src/features/ext/ws-frame.ts",
    "./model-task-catalog": "./src/contracts/model-task-catalog.ts",
    "./plugin-presentation": "./src/features/plugins/presentation.ts",
    "./message-reactions": "./src/features/chat/message-reactions.ts",
    "./vault-item-types": "./src/features/secrets/vault-item-types.ts",
    "./usage-types": "./src/features/usage/usage-types.ts",
    "./inline-completion-contracts": "./src/features/inline-completion/contracts.ts",
    "./settings-limits": "./src/contracts/settings-limits.ts",
    "./request-limits": "./src/lib/request-limits.ts",
    "./client-header": "./src/lib/client-header.ts",
    "./context-exclusions": "./src/contracts/context-exclusion-schema.ts"
  },
  "scripts": {
    "dev": "bun ../../scripts/dev-api.mjs",
    "start": "bun bin/localix",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test src",
    "type-check": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.tmp/tsconfig.tsbuildinfo",
    "type-check:tests": "tsc --noEmit -p tsconfig.test.json",
    "validate:plugins": "bun scripts/validate-plugins.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:audit": "bun run src/db/audit-cli.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@localixai/agent": "workspace:*",
    "@localixai/change-feed": "workspace:*",
    "@localixai/engine": "workspace:*",
    "@localixai/markdown": "workspace:*",
    "@localixai/notifications": "workspace:*",
    "@localixai/os-open": "workspace:*",
    "@localixai/path-containment": "workspace:*",
    "@localixai/plugin-sdk": "workspace:*",
    "@localixai/search": "workspace:*",
    "@localixai/visual-feedback": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@parcel/watcher": "^2.5.1",
    "@vtsls/language-server": "^0.3.0",
    "@xterm/headless": "^6.0.0",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "dockerfile-language-server-nodejs": "^0.15.0",
    "hono": "^4.12.30",
    "kysely": "^0.29.6",
    "linkedom": "^0.18.13",
    "picomatch": "^4.0.5",
    "pino": "10.3.1",
    "shell-quote": "^1.12.0",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vscode-jsonrpc": "^9.0.3",
    "vscode-langservers-extracted": "^4.10.0",
    "yaml": "^2.9.0",
    "yaml-language-server": "^1.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@localixai/engine-scripts": "workspace:*",
    "@localixai/source-lint": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/picomatch": "^4",
    "@types/shell-quote": "^1.7.5",
    "typescript": "^7.0.2"
  }
}

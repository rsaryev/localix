{
  "$comment": "Language servers Localix installs on first use (lsp-registry.ts). `source` is a package URL: pkg:npm (installed with Localix's Bun), pkg:github (a release asset per platform, checked by sha256), pkg:golang (built with the user's Go). `bin` names the commands it provides. `hold` keeps a package within a range when updating. Update every version with `bun run --cwd apps/api lsp:update`.",
  "servers": {
    "typescript": {
      "source": "pkg:npm/%40vtsls/language-server@0.3.0",
      "bin": ["vtsls"]
    },
    "vscode-langservers": {
      "source": "pkg:npm/vscode-langservers-extracted@4.10.0",
      "bin": [
        "vscode-json-language-server",
        "vscode-css-language-server",
        "vscode-html-language-server"
      ]
    },
    "yaml": {
      "source": "pkg:npm/yaml-language-server@2.0.0",
      "bin": ["yaml-language-server"]
    },
    "dockerfile": {
      "source": "pkg:npm/dockerfile-language-server-nodejs@0.15.0",
      "bin": ["docker-langserver"]
    },
    "pyright": {
      "source": "pkg:npm/pyright@1.1.414",
      "bin": ["pyright-langserver"]
    },
    "typescript-language-server": {
      "source": "pkg:npm/typescript-language-server@6.0.2",
      "with": ["pkg:npm/typescript@5.9.3"],
      "hold": {
        "typescript": "<6"
      },
      "bin": ["typescript-language-server"]
    },
    "intelephense": {
      "source": "pkg:npm/intelephense@1.18.5",
      "bin": ["intelephense"]
    },
    "gopls": {
      "source": "pkg:golang/golang.org/x/tools/gopls@v0.24.0",
      "bin": ["gopls"]
    },

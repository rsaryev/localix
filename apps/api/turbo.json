{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "type-check:tests": {
      "dependsOn": ["^type-check"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/test-deadline.ts",
        "$TURBO_ROOT$/scripts/test-globals-guard.ts",
        "$TURBO_ROOT$/scripts/test-shards.mjs",
        "$TURBO_ROOT$/scripts/test-all.mjs",
        "$TURBO_ROOT$/packages/testing/src/**",
        "$TURBO_ROOT$/packages/kit/test-preload.ts"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/test-deadline.ts",
        "$TURBO_ROOT$/scripts/test-globals-guard.ts",
        "$TURBO_ROOT$/scripts/test-shards.mjs",
        "$TURBO_ROOT$/scripts/test-all.mjs",
        "$TURBO_ROOT$/packages/testing/src/**",
        "$TURBO_ROOT$/packages/kit/test-preload.ts"
      ],
      "outputs": []
    }
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // MUST NOT exceed tsconfig.build.json. That file emits the production bundle and its own
    // comment says "keep in sync with tsconfig.json" — it was not: this gate sat at ES2023 while
    // the build sat at ES2022, so the fast check that everyone runs ACCEPTED what the slow one
    // that actually ships REJECTS. Measured: `Array.prototype.findLast` (ES2023) passed
    // `tsc --noEmit -p tsconfig.json` with exit 0 and failed `@localixai/api:build` with TS2550.
    // A permissive gate in front of a strict one is worse than no gate — it converts a build
    // failure into a surprise. Raise BOTH together, deliberately, or neither.
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "rootDir": "../..",
    "outDir": "dist",
    "typeRoots": ["../../node_modules/@types"],
    "types": ["bun"],
    // `@rsaryev/llx-plugin` is linked from a sibling checkout and its dist goes stale while the
    // kit is edited: its own `llx-plugin-source` condition maps every subpath to the src Bun runs
    // (kit README, "Type-check against the source"). Restated here because `customConditions` is
    // replaced, not merged, by an extending config. The kit's src imports with `.ts` extensions,
    // which `rewriteRelativeImportExtensions` accepts, and uses ES2023 (`toSorted`, `findLast`):
    // `lib` above, kept equal in tsconfig.build.json.
    "customConditions": ["@localixai/source", "llx-plugin-source"],
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*", "migrations/**/*"],
  "exclude": ["src/**/*.test.ts"]
}

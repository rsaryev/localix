{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "docs:gen"],
      "env": ["LOCALIX_BUILD_STAMP"],
      "outputs": [
        "dist/**",
        "!dist/.cache/**",
        "public/**",
        "server/**",
        "build/**",
        "src/views/main/**",
        "src/resources/**",
        "src/generated/**"
      ]
    },
    "docs:gen": {
      "dependsOn": ["^build"],
      "outputs": ["src/generated/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["HOST", "PORT", "NODE_ENV", "LOCALIX_*", "VITE_*"],
      "cache": false,
      "persistent": true
    },
    "dev:prepare": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/test-deadline.ts",
        "$TURBO_ROOT$/scripts/test-globals-guard.ts",
        "$TURBO_ROOT$/scripts/test-shards.mjs",
        "$TURBO_ROOT$/scripts/test-all.mjs",
        "$TURBO_ROOT$/packages/testing/src/**",
        "$TURBO_ROOT$/packages/kit/test-preload.ts"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/test-deadline.ts",
        "$TURBO_ROOT$/scripts/test-globals-guard.ts",
        "$TURBO_ROOT$/scripts/test-shards.mjs",
        "$TURBO_ROOT$/scripts/test-all.mjs",
        "$TURBO_ROOT$/packages/testing/src/**",
        "$TURBO_ROOT$/packages/kit/test-preload.ts"
      ],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "type-check:tests": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "tauri:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}

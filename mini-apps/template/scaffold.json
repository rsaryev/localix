{
  "$comment": "What a copy of this mini app is made of. Read by the mini-app-authoring plugin (plugins/mini-app-authoring: the scaffold, the residue check and the skills) and by staging (scripts/stage-mini-app-kit.mjs ships the template minus authoringOnly). The template owns its own domain, so the host names no mini app identity. Placeholders: {name} lower-kebab, {snake} lower_snake, {displayName}.",
  "summary": "System Overview reference mini app (live OS, CPU, memory and process data, plus marks the user and the agent save)",
  "domainName": "System Overview",
  "entry": [
    "mini-app.json",
    "guide.md",
    "ui/register.tsx",
    "ui/Workspace.tsx",
    "backend/index.ts",
    "backend/routes.ts"
  ],
  "domain": [
    "shared/system.ts",
    "shared/processes.ts",
    "shared/system-marks.ts",
    "backend/system.ts",
    "backend/system.test.ts",
    "backend/processes.ts",
    "backend/processes.test.ts",
    "backend/system-marks.ts",
    "backend/system-marks.test.ts",
    "backend/context.ts",
    "ui/system/",
    "screenshots/"
  ],
  "patterns": [
    {
      "use": "a tool that acts on stored state (input, mutates, sequential)",
      "file": "backend/index.ts",
      "anchor": "system_mark"
    },
    {
      "use": "routes that change state and answer with the new state",
      "file": "backend/routes.ts",
      "anchor": "/marks"
    },
    {
      "use": "state the user creates, kept under ctx.dataDir",
      "file": "backend/system-marks.ts",
      "anchor": "openJsonStore"
    },
    {
      "use": "a form and a list driven by send(), with kit Input, Button and IconButton",
      "file": "ui/system/SystemMarks.tsx",
      "anchor": "marks.send"
    },
    {
      "use": "the store feed that nudges an open view after any store write (a per-chat store resolves ctx.sessionStorage)",
      "file": "backend/index.ts",
      "anchor": "createStoreFeed"
    },
    {
      "use": "a list the agent's tool also changes, re-read on the store feed's nudge instead of polled",
      "file": "ui/system/SystemMarks.tsx",
      "anchor": "useStoreSnapshot"
    },
    {
      "use": "a failed read reported through the host's ProblemLine, never a hand-made alert",
      "file": "ui/system/useSystemProblem.ts",
      "anchor": "useProblemReport"
    },
    {
      "use": "a value derived from a timestamp against useNow()",
      "file": "ui/system/SystemOverview.tsx",
      "anchor": "useNow"
    },
    {
      "use": "the resource the open tab attaches to a message, and the provider that reads it",
      "file": "backend/context.ts",
      "anchor": "expand"
    },
    {
      "use": "tests of stored state, routes and the acting tool",
      "file": "backend/system-marks.test.ts",
      "anchor": "register(ctx)"
    }
  ],
  "authoringOnly": [
    "package.json",
    "bunfig.toml",
    "tsconfig.json",
    "tsconfig.tests.json",
    "vite.config.ts",
    "index.html",
    "preview/",
    "ui/register.test.tsx",
    "ui/Workspace.dom.test.tsx",
    "ui/usePolledSnapshot.dom.test.tsx",
    "ui/useStoreSnapshot.dom.test.tsx"
  ],
  "domainNamedPaths": ["system", "process"],
  "domainTokens": [
    "SYSTEM_URI",
    "SystemOverview",
    "SystemSnapshot",
    "systemSnapshotSchema",
    "formatSystemSnapshot",
    "createSystemReader",
    "SystemReader",
    "ProcessSnapshot",
    "processSnapshotSchema",
    "formatProcessSnapshot",
    "createProcessService",
    "ProcessService",
    "useSystem",
    "systemMarksSchema",
    "createSystemMarks",
    "SystemMarksService",
    "formatSystemMarks"
  ],
  "renames": [
    {
      "pattern": "\\bsystem_overview",
      "replacement": "{snake}_overview"
    },
    {
      "pattern": "\\bsystem_processes",
      "replacement": "{snake}_processes"
    },
    {
      "pattern": "\\bsystem_mark\\b",
      "replacement": "{snake}_mark"
    },
    {
      "pattern": "\\binspect-system\\b",
      "replacement": "inspect-{name}"
    },
    {
      "pattern": "System Overview",
      "replacement": "{displayName}"
    },
    {
      "pattern": "System overview",
      "replacement": "{displayName}"
    }
  ],
  "directoryRenames": [],
  "tools": ["{snake}_overview", "{snake}_processes", "{snake}_mark"]
}

{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "type-check": {
      "dependsOn": ["^type-check", "@localixai/kit#type-check"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/ui/src/**"]
    },
    "type-check:tests": {
      "dependsOn": ["^type-check", "@localixai/kit#type-check:tests"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/ui/src/**"]
    }
  }
}

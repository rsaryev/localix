{
  "name": "localix",
  "private": true,
  "description": "Open source Agentic Development Environment: a team of AI agents with your editor, terminals and browser. Use any model, or run one locally.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "scripts",
    "vendor/monaco-editor-runtime"
  ],
  "scripts": {
    "dev": "cd apps/desktop-tauri && bun run tauri:dev",
    "dev:web": "bun scripts/dev-servers.mjs --isolated",
    "prepare": "git config core.hooksPath .githooks",
    "build:desktop": "bunx turbo build --filter=@localixai/api && cd apps/desktop-tauri && bun run tauri:build",
    "release:desktop": "bunx turbo build --filter=@localixai/api && cd apps/desktop-tauri && bun run tauri:release",
    "dev:landing": "bunx turbo dev --filter=@localixai/landing",
    "build:landing": "bunx turbo build --filter=@localixai/landing",
    "dev:workspace": "bun scripts/dev-servers.mjs --workspace",
    "build": "bunx turbo build",
    "test": "bunx turbo test --concurrency=${TURBO_CONCURRENCY:-50%} ${TURBO_FILTER:-}",
    "test:integration": "bunx turbo test:integration --concurrency=${TURBO_CONCURRENCY:-50%} ${TURBO_FILTER:-}",
    "coverage": "bun scripts/coverage.mjs",
    "logs": "bun scripts/logs.mjs",
    "lint": "oxlint --type-aware",
    "type-check": "bunx turbo type-check --concurrency=${TURBO_CONCURRENCY:-50%} ${TURBO_FILTER:-}",
    "check:compression": "bun apps/api/scripts/check-compression.ts",
    "check:ui-startup": "bun run --cwd apps/ui check:startup",
    "check:tests": "bunx turbo type-check:tests --concurrency=${TURBO_CONCURRENCY:-50%} ${TURBO_FILTER:-}",
    "check:rust": "bunx turbo tauri:check",
    "check:bundle": "bun apps/desktop-tauri/scripts/prepare-sidecar.mjs && bun apps/desktop-tauri/scripts/smoke-bundle.mjs",
    "clean": "bunx turbo clean && shx rm -rf node_modules",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:changed": "oxlint --type-aware $(git diff --name-only --diff-filter=d main -- '*.ts' '*.tsx' '*.mjs' '*.js' | tr '\\n' ' ')",
    "lint:react-doctor": "oxlint -c config/oxlint-react-doctor.json apps/api/src apps/desktop-tauri/scripts apps/landing/src apps/ui/src packages plugins scripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check:size": "bun scripts/code-budget.mjs",
    "check:public": "bun scripts/check-public-repo.mjs",
    "check:architecture": "bun scripts/check-architecture.mjs",
    "check:docs": "bun scripts/check-doc-refs.mjs",
    "check:generated": "bun scripts/check-generated.mjs",
    "check:plugins": "bun run --cwd apps/api validate:plugins --strict",
    "check:audit": "bun audit --audit-level=moderate --ignore=GHSA-vfj7-8cjw-p6xm --ignore=GHSA-hp3w-g68c-fv3c",
    "check:deadcode": "VITE_API_BASE_URL=http://127.0.0.1:1 knip --include files,dependencies,unlisted,unresolved,binaries --no-config-hints",
    "deadcode": "VITE_API_BASE_URL=http://127.0.0.1:1 knip",
    "check:globals": "TEST_GLOBALS_STRICT=1 bun test apps/api/src/features apps/ui/src packages",
    "screenshots:prepare": "bun scripts/screenshots/runtime.mjs",
    "screenshots:seed": "bun scripts/screenshots/seed.mjs",
    "test:screenshots": "bun scripts/screenshots/run.mjs",
    "screenshots:update": "bun scripts/screenshots/run.mjs --update",
    "screenshots:publish": "bun scripts/screenshots/publish.mjs",
    "screenshots:audit": "bun scripts/screenshots/audit.mjs",
    "screenshots:coverage": "bun scripts/screenshots/workbench-coverage.mjs"
  },
  "devDependencies": {
    "@localixai/plugin-kit-compiler": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "hono": "^4.13.13",
    "knip": "^6.42.1",
    "oxc-parser": "^0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2004",
    "shx": "^0.4.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "@radix-ui/react-dialog": "1.3.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/mocker": "4.1.11",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.9",
    "dompurify": "3.4.16",
    "fast-uri": "3.1.8",
    "hono": "4.13.13",
    "ip-address": "10.7.2",
    "js-yaml": "3.15.2",
    "nanoid": "3.3.18",
    "pbkdf2": "3.1.7",
    "pdfjs-dist": "6.4.299",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "tinypool": "2.2.0",
    "undici": "7.30.0",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.4"
}

# Check text out with LF on every platform. The repository is stored with LF, and a Windows
# checkout converting to CRLF changes the bytes that hashes and generated-file checks read.
* text=auto eol=lf

# Generated third-party runtime: keep it reviewable, but exclude it from language
# statistics and collapse its diffs on GitHub by default.
vendor/monaco-editor-runtime/esm/** linguist-vendored linguist-generated
vendor/monaco-editor-runtime/LICENSE linguist-vendored
vendor/monaco-editor-runtime/ThirdPartyNotices.txt linguist-vendored

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["vendor/**"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "mini-apps/*/tools/**/*.mjs",
        "mini-apps/*/hooks/**/*.mjs",
        "mini-apps/*/arg-sources/**/*.ts"
      ],
      "project": ["mini-apps/**/*.{ts,mjs}"]
    },
    "scripts": {
      "entry": [
        "*.mjs",
        "*.ts",
        "lib/wait.mjs",
        "cc-parity/run.mjs",
        "screenshots/{audit,fixture-service,publish,run,runtime,scripted-provider,seed,workbench-coverage}.mjs",
        "screenshots/playwright.config.mjs",
        "screenshots/*.pw.mjs",
        "**/*.test.{ts,mjs}"
      ],
      "project": ["**/*.{mjs,ts}"]
    },
    "apps/api": {
      "entry": [
        "src/index.ts",
        "src/bootstrap.ts",
        "migrations/*.ts",
        "scripts/**/*.ts",
        "src/**/*.test.ts",
        "src/**/testing/fake-*.ts"
      ],
      "ignoreDependencies": [
        "@parcel/watcher-darwin-arm64",
        "@parcel/watcher-darwin-x64",
        "@parcel/watcher-linux-arm64-glibc",
        "@parcel/watcher-linux-arm64-musl",
        "@parcel/watcher-linux-x64-glibc",
        "@parcel/watcher-linux-x64-musl",
        "@parcel/watcher-win32-arm64",
        "@parcel/watcher-win32-x64"
      ]
    },
    "apps/ui": {
      "entry": [
        "src/app/main.tsx",
        "vite.config.ts",
        "src/**/*.surface.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "build/**/*.test.ts"
      ],
      "ignoreDependencies": [
        "vaul",
        "@fontsource-variable/dm-sans",
        "@fontsource-variable/fira-code",
        "@fontsource-variable/geist",
        "@fontsource-variable/jetbrains-mono",
        "@fontsource/fragment-mono"
      ]
    },
    "apps/landing": {
      "entry": ["src/main.tsx", "vite.config.ts", "scripts/**/*.mjs"],
      "ignoreDependencies": ["@happy-dom/global-registrator"]
    },
    "apps/desktop-tauri": {
      "entry": ["scripts/**/*.test.ts", "scripts/check-*.mjs"]
    },
    "mini-apps/*": {
      "entry": [
        "ui/register.tsx",
        "backend/index.ts",
        "arg-sources/**/*.ts",
        "tools/**/*.mjs",
        "hooks/**/*.mjs",
        "**/*.test.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx}"]
    },
    "mini-apps/devops": {
      "entry": [
        "ui/register.tsx",
        "backend/index.ts",
        "arg-sources/**/*.ts",
        "tools/**/*.mjs",
        "hooks/**/*.mjs",
        "**/*.test.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["@happy-dom/global-registrator", "radix-ui"]
    },
    "mini-apps/template": {
      "entry": ["backend/index.ts", "ui/system/SystemMarks.tsx", "**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["ui/register.example.tsx"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx,mjs}"]
    },
    "packages/engine-scripts": {
      "entry": ["src/index.ts", "src/worker.ts", "src/**/*.test.ts"]
    },
    "packages/kit": {
      "entry": ["src/entries/*.ts", "src/testing/*.ts", "**/*.test.{ts,tsx}", "test-preload.ts"],
      "ignoreDependencies": ["mediabunny"]
    },
    "packages/cli": {
      "entry": ["bin/localix.mjs", "src/main.ts", "src/**/*.test.ts", "scripts/**/*.mjs"]
    },
    "packages/mini-app-sdk": {
      "entry": ["src/backend/index.ts", "src/ui/index.ts", "src/manifest/index.ts"]
    }
  },
  "ignore": ["apps/desktop-tauri/src-tauri/resources/**", "apps/desktop-tauri/src-tauri/target/**"],
  "ignoreDependencies": [
    "@vtsls/language-server",
    "dockerfile-language-server-nodejs",
    "vscode-langservers-extracted",
    "yaml-language-server",
    "@types/shell-quote",
    "tailwindcss",
    "@localixai/visual-feedback"
  ],
  "ignoreBinaries": ["lipo", "rustc", "strip", "tauri"]
}

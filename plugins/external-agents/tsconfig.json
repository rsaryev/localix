{
  "//": "Plugin-owned compile project for backend, UI, tests, editors, and type-aware lint.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    // DOM.AsyncIterable: the backend reads transcripts with `for await` over `Bun.file().stream()`,
    // and without it the DOM `ReadableStream` type declares no async iterator.
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["bun", "vite/client"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    // The kit is the plugin's only view of the host: `@localixai/kit/<id>` is a door of the
    // package (`packages/kit/src/entries`) or a module the host lends (`apps/ui/src/app/kit`).
    // `@/*` is here solely so the compiler can follow a lent module's own imports; plugin code
    // never names it (the artifact build and `plugin-boundary-contract.test.ts` both refuse it).
    "paths": {
      "@localixai/kit/*": ["../../packages/kit/src/entries/*", "../../apps/ui/src/app/kit/*"],
      "@/*": ["../../apps/ui/src/*"]
    }
  }
}

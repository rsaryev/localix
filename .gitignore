# Patterns for node_modules, .turbo and dist intentionally have no trailing slash, so they also
# match a symlink to those directories: git treats a symlink as a file, and a trailing-slash
# pattern matches real directories only.
node_modules
apps/api/public
apps/api/tmp/
dist
!vendor/monaco-editor-runtime/esm/external/@vscode/l10n/dist
!vendor/monaco-editor-runtime/esm/external/@vscode/l10n/dist/browser.js
coverage/
test-results/
*.tsbuildinfo

.DS_Store
.playwright-mcp/

*.log
*.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

*.tgz

.env
.env.*
.turbo
benchmarks/

# Database
.data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
# SQLite's special in-memory filename must include the trailing colon. These
# basename patterns keep accidental placeholder files out of the repository.
**/:memory
**/:mamory

# CLI package build artifacts (generated by packages/cli/scripts/build.mjs)
packages/cli/public/
packages/cli/server/

tmp/

# Claude Code's local state stays out; the repository's shared skills are versioned.
.claude/*
!.claude/skills/
.localix/

# Local skill-manager state (not part of the product)
skills-lock.json

# Written into the cwd by a bash read-only test that runs `touch`
probe-mutation.txt

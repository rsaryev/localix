{
  "limit": 500000,
  "exclude": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/dist/**",
    "**/generated/**",
    "**/testing/**",
    "**/fixtures/**",
    "**/__fixtures__/**",
    "**/*.test-utils.ts",
    "**/*.test-utils.tsx",
    "**/test-harness.ts",
    "**/test-preload.ts",
    "scripts/**",
    "apps/*/scripts/**",
    "apps/ui/build/**",
    "packages/oxlint-rules/**",
    "packages/source-lint/**",
    "**/*.config.ts",
    "**/*.config.mjs",
    "**/*.config.js",
    ".githooks/**"
  ]
}

{
  "name": "@localixai/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/app/entry-server.tsx --outDir dist-ssr && bun scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "bun scripts/lint.mjs",
    "check": "bun run lint && bun run build",
    "sync": "sh scripts/sync.sh"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "highlight.js": "^11.12.0",
    "@localix-ai/flowdown": "^0.5.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "description": "Localix Studio's landing and docs, made from llx-sitekit.",
  "sitekit": {
    "template": "https://github.com/rsaryev/llx-sitekit.git",
    "branch": "main",
    "synced": "9ccf84210eb33759a44fa571a4d4e512e2b7d980"
  }
}
